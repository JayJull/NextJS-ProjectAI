generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Kategori {
  id Int @id @default(autoincrement())
  nama String
  Ais Ai[]
}

model Ai {
  id Int @id @default(autoincrement())
  name String
  deskripsi String
  url String
  gambar String
  kategoriId Int
  kategori Kategori @relation(fields: [kategoriId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
